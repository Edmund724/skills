{
  "targets": [
    {
      "name": "antigravity",
      "detect": "~/.gemini/config",
      "rules": {
        "src": "AGENTS.md",
        "dest": "~/.gemini/config/AGENTS.md",
        "mode": "link"
      }
    },
    {
      "name": "dsh",
      "detect": "~/.dsh",
      "rules": {
        "src": "AGENTS.md",
        "dest": "~/.dsh/AGENTS.md",
        "mode": "link"
      }
    }
  ]
}
